# Production copy of this file lives at /etc/proofpay/env (owner root:root, mode 0600).

POSTGRES_PASSWORD=change-me
PROOFPAY_DATABASE_URL=postgresql+psycopg://proofpay:<password>@postgres:5432/proofpay
PROOFPAY_PAYPAL_CLIENT_ID=your-paypal-client-id
PROOFPAY_PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PROOFPAY_GITHUB_TOKEN=your-github-token
PROOFPAY_GEMINI_API_KEY=your-gemini-api-key
PROOFPAY_LLM_MODEL=gemini-3-flash-preview
PROOFPAY_FALLBACK_BASE_URL=
PROOFPAY_FALLBACK_MODEL=
PROOFPAY_FALLBACK_API_KEY=
